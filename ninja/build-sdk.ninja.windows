 command = /bin/bash -c "(rm -rf /out.windows/host/linux-x86/sdk/sdk/android-sdk_eng.sbkang_linux-x86 /out.windows/host/linux-x86/sdk/sdk/android-sdk_eng.sbkang_linux-x86.zip ) && (for f in ; do 	  if [ -f \$$f ]; then 	    echo SDK: warning: 	        including GNU target \$$f >&2; 	    FAIL=; 	  fi; 	done; 	if [ \$$FAIL ]; then exit 1; fi ) && (echo NanumGothic.ttf DroidSansFallback.ttf | tr \" \" \"\\n\"  > /out.windows/host/common/obj/PACKAGING/sdk-fonts_intermediates/fontsInSdk.txt ) && (( 		ATREE_STRIP=\"strip -x\" 		/out.windows/host/linux-x86/bin/atree 		-f development/build/sdk.exclude.atree -f development/build/sdk-linux-x86.atree -f development/build/sdk.atree 			-m /out.windows/host/linux-x86/sdk/sdk/sdk_deps.mk 			-I . 			-I /out.windows/target/product/generic 			-I /out.windows/host/linux-x86 			-I /out.windows/target/common 			-v \"PLATFORM_NAME=android-8.1.0\" 			-v \"OUT_DIR=/out.windows\" 			-v \"HOST_OUT=/out.windows/host/linux-x86\" 			-v \"TARGET_ARCH=arm\" 			-v \"TARGET_CPU_ABI=armeabi-v7a\" 			-v \"DLL_EXTENSION=.so\" 			-v \"FONT_OUT=/out.windows/host/common/obj/PACKAGING/sdk-fonts_intermediates\" 			-v \"JACK_SDKTOOL_VERSION=\" 			-o /out.windows/host/linux-x86/sdk/sdk/android-sdk_eng.sbkang_linux-x86 && 		cp -f /out.windows/target/product/generic/obj/NOTICE.txt 				/out.windows/host/linux-x86/sdk/sdk/android-sdk_eng.sbkang_linux-x86/system-images/android-8.1.0/armeabi-v7a/NOTICE.txt && 		cp -f /out.windows/host/linux-x86/obj/NOTICE.txt /out.windows/host/linux-x86/sdk/sdk/android-sdk_eng.sbkang_linux-x86/platform-tools/NOTICE.txt && 		HOST_OUT_EXECUTABLES=/out.windows/host/linux-x86/bin HOST_OS=linux 			development/build/tools/sdk_clean.sh /out.windows/host/linux-x86/sdk/sdk/android-sdk_eng.sbkang_linux-x86 && 		chmod -R ug+rwX /out.windows/host/linux-x86/sdk/sdk/android-sdk_eng.sbkang_linux-x86 && 		cd /out.windows/host/linux-x86/sdk/sdk/ && zip -rqX android-sdk_eng.sbkang_linux-x86.zip android-sdk_eng.sbkang_linux-x86 	) || ( rm -rf /out.w