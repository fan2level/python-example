 command = /bin/bash -c "(grep -v \"ro.build.user=\\|ro.build.host=\\|ro.product.brand=\\|ro.product.manufacturer=\\|ro.product.device=\\|ro.build.product=\" /out.windows/target/product/generic/system/build.prop > /out.windows/target/product/generic/sdk/sdk-build.prop.tmp ) && (for x in ro.build.user= ro.build.host= ro.product.brand= ro.product.manufacturer= ro.product.device= ro.build.product=; do 				echo \"\$$x\"generic >> /out.windows/target/product/generic/sdk/sdk-build.prop.tmp; done ) && (mv /out.windows/target/product/generic/sdk/sdk-build.prop.tmp /out.windows/target/product/generic/sdk/sdk-build.prop )"
build /out.windows/target/product/generic/sdk/sdk-build.prop: rule3831 /out.windows/target/product/generic/system/build.prop
