al.mk\\\" [ label=\\\"build/target/product/\\\\ncore_minimal.mk\\\\n\\\\n\\\\n\\\"  colorscheme=\\\"svg\\\" fontcolor=\\\"darkblue\\\" href=\\\"products/build/target/product/core_minimal.mk.html\\\" ] >> /out.windows/products.dot.in ) && (echo \\\"build/target/product/embedded.mk\\\" [ label=\\\"build/target/product/\\\\nembedded.mk\\\\n\\\\n\\\\n\\\"  colorscheme=\\\"svg\\\" fontcolor=\\\"darkblue\\\" href=\\\"products/build/target/product/embedded.mk.html\\\" ] >> /out.windows/products.dot.in ) && (echo \\\"build/target/product/runtime_libart.mk\\\" [ label=\\\"build/target/product/\\\\nruntime_libart.mk\\\\n\\\\n\\\\n\\\"  colorscheme=\\\"svg\\\" fontcolor=\\\"darkblue\\\" href=\\\"products/build/target/product/runtime_libart.mk.html\\\" ] >> /out.windows/products.dot.in ) && (echo \\\"build/target/product/sdk.mk\\\" [ label=\\\"build/target/product/\\\\nsdk.mk\\\\n\\\\n\\\\ngeneric\\\"  style=\\\"filled\\\" fillcolor=\\\"#FFFDB0\\\" colorscheme=\\\"svg\\\" fontcolor=\\\"darkblue\\\" href=\\\"products/build/target/product/sdk.mk.html\\\" ] >> /out.windows/products.dot.in ) && (echo \\\"build/target/product/sdk_base.mk\\\" [ label=\\\"build/target/product/\\\\nsdk_base.mk\\\\n\\\\n\\\\n\\\"  colorscheme=\\\"svg\\\" fontcolor=\\\"darkblue\\\" href=\\\"products/build/target/product/sdk_base.mk.html\\\" ] >> /out.windows/products.dot.in ) && (echo \\\"build/target/product/sdk_phone_armv7.mk\\\" [ label=\\\"build/target/product/\\\\nsdk_phone_armv7.mk\\\\n\\\\n\\\\n\\\"  colorscheme=\\\"svg\\\" fontcolor=\\\"darkblue\\\" href=\\\"products/build/target/product/sdk_phone_armv7.mk.html\\\" ] >> /out.windows/products.dot.in ) && (echo '}' >> /out.windows/products.dot.in ) && (./build/tools/filter-product-graph.py build/target/product/sdk.mk < /out.windows/products.dot.in > /out.windows/products.dot )"
