build /out.arm64/target/product/generic/obj/NOTICE_FILES/src/system/etc/general_sepolicy.conf.txt: rule2182 system/sepolicy/NOTICE
build device_file_contexts.bin_all_targets: phony _kati_always_build_ /out.arm64/target/product/generic/obj/ETC/file_contexts.bin_intermediates/file_contexts.bin /out.arm64/target/product/generic/root/file_contexts.bin
