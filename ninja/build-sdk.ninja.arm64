rule rule308
 description = Install: /out.arm64/host/linux-x86/bin/adb
 command = /bin/bash -c "(rm -f /out.arm64/host/linux-x86/bin/adb ) && (cp /out.arm64/host/linux-x86/obj/EXECUTABLES/adb_intermediates/adb /out.arm64/host/linux-x86/bin/adb )"
build /out.arm64/host/linux-x86/bin/adb: rule308 /out.arm64/host/linux-x86/obj/EXECUTABLES/adb_intermediates/adb || /out.arm64/host/linux-x86/obj/NOTICE_FILES/src/bin/adb.txt NOTICE-HOST-STATIC_LIBRARIES-libadb NOTICE-HOST-STATIC_LIBRARIES-libbase NOTICE-HOST-STATIC_LIBRARIES-libcrypto_utils NOTICE-HOST-STATIC_LIBRARIES-libcrypto NOTICE-HOST-STATIC_LIBRARIES-libdiagnose_usb NOTICE-HOST-STATIC_LIBRARIES-liblog NOTICE-HOST-STATIC_LIBRARIES-libmdnssd NOTICE-HOST-STATIC_LIBRARIES-libcutils NOTICE-HOST-STATIC_LIBRARIES-libusb NOTICE-HOST-STATIC_LIBRARIES-libc++_static NOTICE-HOST-STATIC_LIBRARIES-libcompiler_rt-extras
