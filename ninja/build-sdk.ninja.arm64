rule rule2178
 description = Install: /out.arm64/target/product/generic/recovery/root/sepolicy
 command = /bin/bash -c "(rm -f /out.arm64/target/product/generic/recovery/root/sepolicy ) && (cp /out.arm64/target/product/generic/obj/ETC/sepolicy.recovery_intermediates/sepolicy /out.arm64/target/product/generic/recovery/root/sepolicy )"
build /out.arm64/target/product/generic/recovery/root/sepolicy: rule2178 /out.arm64/target/product/generic/obj/ETC/sepolicy.recovery_intermediates/sepolicy || /out.arm64/target/product/generic/obj/NOTICE_FILES/src/recovery/root/sepolicy.txt
rule rule2179
 description = Notice file: system/sepolicy/NOTICE -- /out.arm64/target/product/generic/obj/NOTICE_FILES/src/recovery/root/sepolicy.txt
 command = /bin/bash -c "cat system/sepolicy/NOTICE > /out.arm64/target/product/generic/obj/NOTICE_FILES/src/recovery/root/sepolicy.txt"
build /out.arm64/target/product/generic/obj/NOTICE_FILES/src/recovery/root/sepolicy.txt: rule2179 system/sepolicy/NOTICE
build device_general_sepolicy.conf_all_targets: phony _kati_always_build_ /out.arm64/target/product/generic/obj/ETC/general_sepolicy.conf_intermediates/general_sepolicy.conf /out.arm64/target/product/generic/system/etc/general_sepolicy.conf
