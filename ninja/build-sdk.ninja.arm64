rule rule117
 description = build $out
 command = /bin/bash -c "(sed -e 's/#.*\$$//' -e '/^\$$/d' /out.arm64/target/product/generic/obj/ETC/plat_hwservice_contexts_intermediates/plat_hwservice_contexts.tmp > /out.arm64/target/product/generic/obj/ETC/plat_hwservice_contexts_intermediates/plat_hwservice_contexts ) && (/out.arm64/host/linux-x86/bin/checkfc -e -l /out.arm64/target/product/generic/obj/ETC/sepolicy_intermediates/sepolicy /out.arm64/target/product/generic/obj/ETC/plat_hwservice_contexts_intermediates/plat_hwservice_contexts )"
