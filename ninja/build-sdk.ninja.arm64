build /out.arm64/target/product/generic/system/etc/general_sepolicy.conf: rule2181 /out.arm64/target/product/generic/obj/ETC/general_sepolicy.conf_intermediates/general_sepolicy.conf || /out.arm64/target/product/generic/obj/NOTICE_FILES/src/system/etc/general_sepolicy.conf.txt
