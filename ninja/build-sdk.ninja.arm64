rule rule2184
 description = Notice file: system/sepolicy/NOTICE -- /out.arm64/target/product/generic/obj/NOTICE_FILES/src/root/file_contexts.bin.txt
 command = /bin/bash -c "cat system/sepolicy/NOTICE > /out.arm64/target/product/generic/obj/NOTICE_FILES/src/root/file_contexts.bin.txt"
