build /out.arm64/target/product/generic/obj/NOTICE_FILES/src/system/etc/selinux/plat_file_contexts.txt: rule115 system/sepolicy/NOTICE
rule rule116
 description = Install: /out.arm64/target/product/generic/system/etc/selinux/plat_hwservice_contexts
 command = /bin/bash -c "(rm -f /out.arm64/target/product/generic/system/etc/selinux/plat_hwservice_contexts ) && (cp /out.arm64/target/product/generic/obj/ETC/plat_hwservice_contexts_intermediates/plat_hwservice_contexts /out.arm64/target/product/generic/system/etc/selinux/plat_hwservice_contexts )"
